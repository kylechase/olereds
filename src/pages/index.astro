---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Olereds Snow Clearing | Professional Driveway Snow Removal">
  <!-- Header / Nav -->
  <header class="bg-red-700 text-white shadow-lg sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
      <a href="#" class="text-2xl font-bold tracking-tight">
        <span class="text-red-200">Olereds</span> Snow Clearing
      </a>
      <nav class="hidden md:flex gap-6 text-sm font-medium">
        <a href="#services" class="hover:text-red-200 transition">Services</a>
        <a href="#why-us" class="hover:text-red-200 transition">Why Us</a>
        <a href="#pricing" class="hover:text-red-200 transition">Pricing</a>
        <a href="#contact" class="hover:text-red-200 transition">Contact</a>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-red-700 via-red-800 to-gray-900 text-white py-24 md:py-32">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">
        Your Driveway, Cleared.<br />
        <span class="text-red-300">Every Time.</span>
      </h1>
      <p class="text-lg md:text-xl text-red-100 mb-8 max-w-2xl mx-auto">
        Reliable, professional snow clearing for residential driveways. Wake up to a clean driveway — no shoveling, no stress.
      </p>
      <a
        href="#contact"
        class="inline-block bg-white text-red-700 font-bold px-8 py-4 rounded-lg text-lg hover:bg-red-50 transition shadow-lg"
      >
        Get a Free Quote
      </a>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Our Services</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-12">
        From the first snowfall to the last, we keep your driveway safe and accessible all winter long.
      </p>
      <div class="grid md:grid-cols-3 gap-8 mb-16">
        <div class="bg-gray-50 rounded-xl p-8 text-center border border-gray-100">
          <div class="text-red-600 mb-4">
            <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Snow Plowing</h3>
          <p class="text-gray-600">Fast, thorough driveway plowing after every snowfall. We clear down to the pavement so you can get moving.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-8 text-center border border-gray-100">
          <div class="text-red-600 mb-4">
            <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Seasonal Contracts</h3>
          <p class="text-gray-600">Lock in your rate for the whole season. No surprises, no per-visit fees — just reliable service all winter.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-8 text-center border border-gray-100">
          <div class="text-red-600 mb-4">
            <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">24-Hour Clearing Guarantee</h3>
          <p class="text-gray-600">We guarantee your driveway will be cleared within 24 hours of any snowfall. No waiting, no wondering.</p>
        </div>
      </div>

      <!-- Add-On Services -->
      <h3 class="text-2xl font-bold text-center mb-2">Add-On Services</h3>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-8">
        Customize your package with these optional add-ons, priced per customer.
      </p>
      <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
        <div class="bg-gray-50 rounded-xl p-8 text-center border border-gray-100">
          <div class="text-red-600 mb-4">
            <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Salt & De-Icing</h3>
          <p class="text-gray-600">We apply salt and de-icing agents to prevent ice buildup and keep your driveway safe for walking and driving.</p>
          <p class="text-red-600 font-semibold mt-3">Contact us for pricing</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-8 text-center border border-gray-100">
          <div class="text-red-600 mb-4">
            <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Walkway Clearing</h3>
          <p class="text-gray-600">We'll clear your walkways, front steps, and paths so every part of your property is safe and accessible.</p>
          <p class="text-red-600 font-semibold mt-3">Contact us for pricing</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Us -->
  <section id="why-us" class="py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Why Choose Olereds?</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-12">
        We're not just another snow clearing company. Here's what sets us apart.
      </p>
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="flex gap-4">
          <div class="shrink-0 w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center text-red-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-lg mb-1">24-Hour Guarantee</h3>
            <p class="text-gray-600">We guarantee your driveway will be cleared within 24 hours of snowfall, so you're never stuck waiting.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="shrink-0 w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center text-red-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-lg mb-1">Fully Insured</h3>
            <p class="text-gray-600">We carry full liability insurance so you can rest easy knowing your property is protected.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="shrink-0 w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center text-red-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-lg mb-1">Local & Trusted</h3>
            <p class="text-gray-600">We're your neighbours. We live and work in this community and take pride in keeping our area safe and clear.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="shrink-0 w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center text-red-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-lg mb-1">Easy Communication</h3>
            <p class="text-gray-600">Need to reach us? Call, text, or email. We respond quickly and keep you informed every step of the way.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Simple, Transparent Pricing</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-12">
        Pick the package that fits your driveway. All plans include snow plowing and seasonal coverage. Add-ons available.
      </p>
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Single -->
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200 flex flex-col">
          <h3 class="text-xl font-bold mb-1">Single Driveway</h3>
          <p class="text-gray-500 text-sm mb-6">Perfect for single-width driveways</p>
          <div class="mb-6">
            <span class="text-4xl font-extrabold text-gray-900">$175</span>
            <span class="text-gray-500">/month</span>
          </div>
          <ul class="space-y-3 text-gray-600 mb-8 grow">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Unlimited snow clearing visits
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Cleared within 24 hours of snowfall
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Single-width driveway
            </li>
          </ul>
          <a href="#contact" class="block text-center bg-red-600 text-white font-bold py-3 rounded-lg hover:bg-red-700 transition">Get Started</a>
        </div>

        <!-- Double (Featured) -->
        <div class="bg-red-700 text-white rounded-2xl p-8 border-2 border-red-600 flex flex-col shadow-xl relative">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-yellow-400 text-gray-900 text-xs font-bold px-4 py-1 rounded-full uppercase tracking-wide">Most Popular</div>
          <h3 class="text-xl font-bold mb-1">Double Driveway</h3>
          <p class="text-red-200 text-sm mb-6">Our most popular package</p>
          <div class="mb-6">
            <span class="text-4xl font-extrabold">$200</span>
            <span class="text-red-200">/month</span>
          </div>
          <ul class="space-y-3 text-red-100 mb-8 grow">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-yellow-300 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Unlimited snow clearing visits
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-yellow-300 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Cleared within 24 hours of snowfall
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-yellow-300 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Double-width driveway
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-yellow-300 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Priority scheduling
            </li>
          </ul>
          <a href="#contact" class="block text-center bg-white text-red-700 font-bold py-3 rounded-lg hover:bg-red-50 transition">Get Started</a>
        </div>

        <!-- Triple -->
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-200 flex flex-col">
          <h3 class="text-xl font-bold mb-1">Triple Driveway</h3>
          <p class="text-gray-500 text-sm mb-6">For large and extended driveways</p>
          <div class="mb-6">
            <span class="text-4xl font-extrabold text-gray-900">$225</span>
            <span class="text-gray-500">/month</span>
          </div>
          <ul class="space-y-3 text-gray-600 mb-8 grow">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Unlimited snow clearing visits
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Cleared within 24 hours of snowfall
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Triple-width driveway
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-green-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Priority scheduling
            </li>
          </ul>
          <a href="#contact" class="block text-center bg-red-600 text-white font-bold py-3 rounded-lg hover:bg-red-700 transition">Get Started</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section id="contact" class="py-20 bg-gray-50">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Get Your Free Quote</h2>
      <p class="text-gray-600 text-center mb-12">
        Fill out the form below and we'll get back to you within 24 hours.
      </p>
      <form
        name="contact"
        method="POST"
        class="bg-white rounded-2xl shadow-lg p-8 space-y-6"
        id="contact-form"
      >
        <div>
          <label for="name" class="block text-sm font-semibold text-gray-700 mb-1">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition"
            placeholder="John Smith"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition"
            placeholder="john@example.com"
          />
        </div>
        <div>
          <label for="phone" class="block text-sm font-semibold text-gray-700 mb-1">Phone Number</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition"
            placeholder="(555) 123-4567"
          />
        </div>
        <div>
          <label for="address" class="block text-sm font-semibold text-gray-700 mb-1">Address</label>
          <input
            type="text"
            id="address"
            name="address"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition"
            placeholder="123 Main St, Anytown"
          />
        </div>
        <div>
          <label for="package" class="block text-sm font-semibold text-gray-700 mb-1">Package</label>
          <select
            id="package"
            name="package"
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition"
          >
            <option value="single">Single Driveway — $175/mo</option>
            <option value="double">Double Driveway — $200/mo</option>
            <option value="triple">Triple Driveway — $225/mo</option>
          </select>
        </div>
        <fieldset>
          <legend class="block text-sm font-semibold text-gray-700 mb-3">Add-On Services</legend>
          <div class="space-y-3">
            <label class="flex items-center gap-3 cursor-pointer">
              <input
                type="checkbox"
                name="addon-salt"
                value="salt"
                class="w-5 h-5 rounded border-gray-300 text-red-600 focus:ring-red-500"
              />
              <span class="text-gray-700">Salt & De-Icing</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
              <input
                type="checkbox"
                name="addon-walkway"
                value="walkway"
                class="w-5 h-5 rounded border-gray-300 text-red-600 focus:ring-red-500"
              />
              <span class="text-gray-700">Walkway Clearing</span>
            </label>
          </div>
        </fieldset>
        <button
          type="submit"
          class="w-full bg-red-600 text-white font-bold py-4 rounded-lg hover:bg-red-700 transition text-lg"
        >
          Request a Quote
        </button>
      </form>
      <div id="form-success" class="hidden bg-green-50 border border-green-200 rounded-2xl p-8 text-center">
        <svg class="w-16 h-16 text-green-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-xl font-bold text-green-800 mb-2">Thank You!</h3>
        <p class="text-green-700">We've received your request and will get back to you within 24 hours.</p>
      </div>
      <div id="form-error" class="hidden bg-red-50 border border-red-200 rounded-2xl p-8 text-center">
        <h3 class="text-xl font-bold text-red-800 mb-2">Something went wrong</h3>
        <p class="text-red-700">Please try again or contact us directly.</p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-400 py-12">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <p class="text-white font-bold text-lg mb-2">Olereds Snow Clearing</p>
      <p class="text-sm mb-4">Keeping your driveway clear, all winter long.</p>
      <p class="text-xs">&copy; {new Date().getFullYear()} Olereds Snow Clearing. All rights reserved.</p>
    </div>
  </footer>

  <script>
    // IMPORTANT: Replace this URL with your deployed Google Apps Script web app URL
    const GOOGLE_APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzInEyMJuY3SRFO7HF7_cKFqqowDdKSZ-Qj9pJHqxMOwpZHcgnHAKlMMwlzCKqBc0vv/exec';

    const form = document.getElementById('contact-form') as HTMLFormElement;
    const success = document.getElementById('form-success') as HTMLElement;
    const error = document.getElementById('form-error') as HTMLElement;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      const data = {
        name: (form.querySelector('#name') as HTMLInputElement).value,
        email: (form.querySelector('#email') as HTMLInputElement).value,
        phone: (form.querySelector('#phone') as HTMLInputElement).value,
        address: (form.querySelector('#address') as HTMLInputElement).value,
        package: (form.querySelector('#package') as HTMLSelectElement).value,
        addonSalt: (form.querySelector('[name="addon-salt"]') as HTMLInputElement).checked,
        addonWalkway: (form.querySelector('[name="addon-walkway"]') as HTMLInputElement).checked,
      };

      try {
        const response = await fetch(GOOGLE_APPS_SCRIPT_URL, {
          method: 'POST',
          body: JSON.stringify(data),
        });

        if (!response.ok) throw new Error('Request failed');

        form.classList.add('hidden');
        success.classList.remove('hidden');
      } catch {
        form.classList.add('hidden');
        error.classList.remove('hidden');
      }
    });
  </script>
</Layout>
