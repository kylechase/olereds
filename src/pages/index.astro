---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ole Reds Commercial Cleaning | Professional Office & Business Cleaning">
  <!-- Header / Nav -->
  <header class="bg-brand-700 text-white shadow-lg sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="#" class="flex items-center gap-3">
        <span class="border-4 border-gray-900 rounded-2xl px-4 py-1.5 text-2xl font-black text-gray-900 tracking-tight leading-none">
          Ole Reds
        </span>
        <span class="text-sm md:text-base font-bold text-gray-900 leading-tight">
          Commercial<br />Cleaning
        </span>
      </a>
      <nav class="hidden md:flex gap-6 text-sm font-medium">
        <a href="#services" class="hover:text-brand-200 transition">Services</a>
        <a href="#locations" class="hover:text-brand-200 transition">Locations</a>
        <a href="#areas" class="hover:text-brand-200 transition">Areas</a>
        <a href="#why-us" class="hover:text-brand-200 transition">Why Us</a>
        <a href="#contact" class="hover:text-brand-200 transition">Contact</a>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-700 via-brand-800 to-gray-900 text-white py-24 md:py-32">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">
        Your Workspace, Spotless.<br />
        <span class="text-brand-300">Every Time.</span>
      </h1>
      <p class="text-lg md:text-xl text-brand-100 mb-8 max-w-2xl mx-auto">
        Reliable, professional commercial cleaning for offices and businesses. Walk into a spotless space — no hassle, no stress.
      </p>
      <a
        href="#contact"
        class="inline-block bg-white text-brand-700 font-bold px-8 py-4 rounded-lg text-lg hover:bg-brand-50 transition shadow-lg"
      >
        Get a Free Quote
      </a>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Our Services</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-12">
        From daily upkeep to deep cleans, we keep your workspace spotless year-round.
      </p>
      <div class="grid md:grid-cols-3 gap-8 mb-16">
        <div class="bg-gray-50 rounded-xl p-8 text-center border border-gray-100">
          <div class="text-brand-600 mb-4">
            <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-6.714 2.143L12 21l-2.286-6.857L3 12l6.714-2.143L12 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Office & Commercial Cleaning</h3>
          <p class="text-gray-600">Thorough cleaning of offices, retail spaces, and commercial properties. We leave every surface spotless.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-8 text-center border border-gray-100">
          <div class="text-brand-600 mb-4">
            <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Recurring Contracts</h3>
          <p class="text-gray-600">Lock in your rate with a recurring cleaning schedule — daily, weekly, or monthly. No surprises, no per-visit fees.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-8 text-center border border-gray-100">
          <div class="text-brand-600 mb-4">
            <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Satisfaction Guarantee</h3>
          <p class="text-gray-600">Not happy with a clean? We'll come back and make it right — guaranteed, no extra charge.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Locations We Clean -->
  <section id="locations" class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Locations We Clean</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-2">
        We provide commercial cleaning for a wide range of spaces, including:
      </p>
      <p class="text-brand-600 font-semibold text-center max-w-2xl mx-auto mb-12">
        Proudly serving Edmonton, Nisku, Leduc, Beaumont, and surrounding areas.
      </p>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="flex items-center gap-4 bg-gray-50 rounded-xl p-6 border border-gray-100">
          <div class="shrink-0 w-12 h-12 bg-brand-100 rounded-lg flex items-center justify-center text-brand-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <span class="font-semibold text-gray-800">Professional Offices</span>
        </div>
        <div class="flex items-center gap-4 bg-gray-50 rounded-xl p-6 border border-gray-100">
          <div class="shrink-0 w-12 h-12 bg-brand-100 rounded-lg flex items-center justify-center text-brand-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="font-semibold text-gray-800">Childcare Facilities</span>
        </div>
        <div class="flex items-center gap-4 bg-gray-50 rounded-xl p-6 border border-gray-100">
          <div class="shrink-0 w-12 h-12 bg-brand-100 rounded-lg flex items-center justify-center text-brand-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4h16v16H4V4zm4 0v16m8-16v16M4 8h4m8 0h4M4 16h4m8 0h4" />
            </svg>
          </div>
          <span class="font-semibold text-gray-800">Entertainment Buildings</span>
        </div>
        <div class="flex items-center gap-4 bg-gray-50 rounded-xl p-6 border border-gray-100">
          <div class="shrink-0 w-12 h-12 bg-brand-100 rounded-lg flex items-center justify-center text-brand-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 01-2-2V5a1 1 0 011-1h16a1 1 0 011 1v1a2 2 0 01-2 2M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
          </div>
          <span class="font-semibold text-gray-800">Storage Centers</span>
        </div>
        <div class="flex items-center gap-4 bg-gray-50 rounded-xl p-6 border border-gray-100">
          <div class="shrink-0 w-12 h-12 bg-brand-100 rounded-lg flex items-center justify-center text-brand-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
          </div>
          <span class="font-semibold text-gray-800">Commercial Warehouses</span>
        </div>
        <div class="flex items-center gap-4 bg-gray-50 rounded-xl p-6 border border-gray-100">
          <div class="shrink-0 w-12 h-12 bg-brand-100 rounded-lg flex items-center justify-center text-brand-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <span class="font-semibold text-gray-800">Retail Centers</span>
        </div>
      </div>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mt-8">
        Don't see your space listed? We also clean other areas and are willing to learn and adapt to your unique needs.
      </p>
    </div>
  </section>

  <!-- Areas We Serve -->
  <section id="areas" class="py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Areas We Serve</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-8">
        We proudly provide commercial cleaning services in:
      </p>
      <div class="flex flex-wrap justify-center gap-3 max-w-2xl mx-auto">
        <span class="bg-white border border-gray-200 text-gray-800 font-semibold px-5 py-2 rounded-full">Edmonton</span>
        <span class="bg-white border border-gray-200 text-gray-800 font-semibold px-5 py-2 rounded-full">Nisku</span>
        <span class="bg-white border border-gray-200 text-gray-800 font-semibold px-5 py-2 rounded-full">Leduc</span>
        <span class="bg-white border border-gray-200 text-gray-800 font-semibold px-5 py-2 rounded-full">Beaumont</span>
        <span class="bg-white border border-gray-200 text-gray-800 font-semibold px-5 py-2 rounded-full">Surrounding Area</span>
      </div>
    </div>
  </section>

  <!-- Why Us -->
  <section id="why-us" class="py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Why Choose Ole Reds?</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-12">
        We're not just another cleaning company. Here's what sets us apart.
      </p>
      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="flex gap-4">
          <div class="shrink-0 w-12 h-12 bg-brand-100 rounded-lg flex items-center justify-center text-brand-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-lg mb-1">Satisfaction Guarantee</h3>
            <p class="text-gray-600">If there are any issues or missed tasks, we'll come back and fix them immediately — no extra charge.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="shrink-0 w-12 h-12 bg-brand-100 rounded-lg flex items-center justify-center text-brand-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-lg mb-1">Fully Licensed & Insured</h3>
            <p class="text-gray-600">We're fully licensed and insured, and adhere to all industry regulations and requirements so you can rest easy knowing your property is protected.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="shrink-0 w-12 h-12 bg-brand-100 rounded-lg flex items-center justify-center text-brand-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a4 4 0 115.072 0C13.671 16.34 13 17.5 13 18.5H11c0-1-.671-2.16-1.536-3.464z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-lg mb-1">Creative Solutions</h3>
            <p class="text-gray-600">Every space is different. We take the time to understand your unique challenges and find creative solutions that work for you.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="shrink-0 w-12 h-12 bg-brand-100 rounded-lg flex items-center justify-center text-brand-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-lg mb-1">Easy Communication</h3>
            <p class="text-gray-600">Need to reach us? Call, text, or email. We respond quickly and keep you informed every step of the way.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section id="contact" class="py-20 bg-gray-50">
    <div class="max-w-2xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Contact Us</h2>
      <p class="text-gray-600 text-center mb-2">
        Fill out the form below and we'll get back to you within 24 hours.
      </p>
      <p class="text-gray-600 text-center mb-12">
        Or reach out directly to Tailer Chase at
        <a href="tel:7805151398" class="text-brand-600 font-semibold hover:underline">780-515-1398</a>
        or
        <a href="mailto:olereds60@gmail.com" class="text-brand-600 font-semibold hover:underline">olereds60@gmail.com</a>.
      </p>
      <form
        name="contact"
        method="POST"
        class="bg-white rounded-2xl shadow-lg p-8 space-y-6"
        id="contact-form"
      >
        <div>
          <label for="name" class="block text-sm font-semibold text-gray-700 mb-1">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
            placeholder="John Smith"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
            placeholder="john@example.com"
          />
        </div>
        <div>
          <label for="phone" class="block text-sm font-semibold text-gray-700 mb-1">Phone Number</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
            placeholder="(555) 123-4567"
          />
        </div>
        <div>
          <label for="address" class="block text-sm font-semibold text-gray-700 mb-1">Business Address</label>
          <input
            type="text"
            id="address"
            name="address"
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
            placeholder="123 Main St, Suite 100, Anytown"
          />
        </div>
        <div>
          <label for="contact-time" class="block text-sm font-semibold text-gray-700 mb-1">When can we contact you?</label>
          <select
            id="contact-time"
            name="contact-time"
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
          >
            <option value="morning">Morning (8am – 12pm)</option>
            <option value="afternoon">Afternoon (12pm – 5pm)</option>
            <option value="evening">Evening (5pm – 8pm)</option>
            <option value="anytime">Anytime</option>
          </select>
        </div>
        <div>
          <label for="details" class="block text-sm font-semibold text-gray-700 mb-1">Additional Details and Information</label>
          <textarea
            id="details"
            name="details"
            rows="4"
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
            placeholder="Tell us about your space, cleaning needs, or anything else we should know."
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full bg-brand-600 text-white font-bold py-4 rounded-lg hover:bg-brand-700 transition text-lg"
        >
          Get in Touch
        </button>
      </form>
      <div id="form-success" class="hidden bg-green-50 border border-green-200 rounded-2xl p-8 text-center">
        <svg class="w-16 h-16 text-green-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-xl font-bold text-green-800 mb-2">Thank You!</h3>
        <p class="text-green-700">We've received your request and will get back to you within 24 hours.</p>
      </div>
      <div id="form-error" class="hidden bg-red-50 border border-red-200 rounded-2xl p-8 text-center">
        <h3 class="text-xl font-bold text-red-800 mb-2">Something went wrong</h3>
        <p class="text-red-700">Please try again or contact us directly.</p>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-400 py-12">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <p class="text-white font-bold text-lg mb-2">Ole Reds Commercial Cleaning</p>
      <p class="text-sm mb-4">Keeping your workspace spotless, all year long.</p>
      <p class="text-xs">&copy; {new Date().getFullYear()} Ole Reds Commercial Cleaning. All rights reserved.</p>
    </div>
  </footer>

  <script>
    // IMPORTANT: Replace this URL with your deployed Google Apps Script web app URL
    const GOOGLE_APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzInEyMJuY3SRFO7HF7_cKFqqowDdKSZ-Qj9pJHqxMOwpZHcgnHAKlMMwlzCKqBc0vv/exec';

    const form = document.getElementById('contact-form') as HTMLFormElement;
    const success = document.getElementById('form-success') as HTMLElement;
    const error = document.getElementById('form-error') as HTMLElement;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      const data = {
        name: (form.querySelector('#name') as HTMLInputElement).value,
        email: (form.querySelector('#email') as HTMLInputElement).value,
        phone: (form.querySelector('#phone') as HTMLInputElement).value,
        address: (form.querySelector('#address') as HTMLInputElement).value,
        contactTime: (form.querySelector('#contact-time') as HTMLSelectElement).value,
        details: (form.querySelector('#details') as HTMLTextAreaElement).value,
      };

      try {
        const response = await fetch(GOOGLE_APPS_SCRIPT_URL, {
          method: 'POST',
          body: JSON.stringify(data),
        });

        if (!response.ok) throw new Error('Request failed');

        form.classList.add('hidden');
        success.classList.remove('hidden');
      } catch {
        form.classList.add('hidden');
        error.classList.remove('hidden');
      }
    });
  </script>
</Layout>
